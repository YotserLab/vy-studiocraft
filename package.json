{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:fe": "vite",
    "dev:be": "DATA_DIR=../data APP_ORIGIN=http://localhost:34567 go -C backend-go run ./cmd/vystudiocraft",
    "dev:render": "tsx watch render-service/server.ts",
    "build": "vite build",
    "build:be": "go -C backend-go build -o ../bin/vystudiocraft ./cmd/vystudiocraft",
    "prod": "bun run build && bun run build:be && bun run start",
    "start": "PORT=34567 WEB_DIR=dist DATA_DIR=data ./bin/vystudiocraft",
    "preview": "vite preview",
    "clean": "rm -rf dist bin",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@remotion/bundler": "^4.0.543",
    "@remotion/cli": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.543",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
