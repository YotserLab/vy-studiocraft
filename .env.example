# GEMINI_API_KEY: Required for Gemini AI API calls (Roteirista IA & Comparar 30s).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:34567"

# VYStudioCraft Runtime Configuration
PORT=34568
DATABASE_URL="data/vystudiocraft.db"
DATA_DIR="data"
ADMIN_EMAIL="admin@vystudiocraft.local"
APP_ORIGIN="http://localhost:34567"
SESSION_DAYS=30
UPLOAD_MAX_MB=512
DEV_MODE=true
SIGNUP_OPEN=false
USE_MOCK_DATA=true
